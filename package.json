    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
