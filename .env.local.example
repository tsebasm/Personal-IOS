# Copia este archivo a .env.local y llena los dos valores.
# Los sacas de tu proyecto de Supabase: Settings -> API.
# El anon key es público a propósito (lo usa el navegador) — la seguridad
# real la da Row Level Security (supabase/migrations/0002_rls.sql), no
# mantener este valor en secreto.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo para `npm run seed` / `npm run seed:reset` (scripts/seed*.mjs).
# Credenciales de tu propia cuenta (las mismas del login) — el script las usa
# únicamente para autenticarse como tú vía signInWithPassword, así los
# inserts/deletes de datos demo pasan por las mismas políticas de RLS que
# usa la app normalmente. No se usa ningún service role key.
# Si tu contraseña incluye "#" (o espacios), enciérrala entre comillas
# dobles — `node --env-file` trata un # sin comillas como inicio de
# comentario y trunca el valor ahí en silencio.
SEED_USER_EMAIL=tu-correo@ejemplo.com
SEED_USER_PASSWORD="tu-contraseña"

# Asistente de IA (app/dashboard/asistente). Se lee solo en el servidor
# (Server Actions) — nunca lleva prefijo NEXT_PUBLIC_, así que nunca llega
# al navegador. Consíguela en console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Exportación a Obsidian / VANT Brain (npm run export:obsidian). Ruta de la
# bóveda; el script solo escribe en su subcarpeta "Personal OS (sync)".
# Usa las credenciales SEED_USER_* de arriba para autenticarse (RLS).
VANT_BRAIN_PATH="C:/VANT/VANT_Brain"
