# Copia este archivo a .env.local y llena los dos valores.
# Los sacas de tu proyecto de Supabase: Settings -> API.
# El anon key es público a propósito (lo usa el navegador) — la seguridad
# real la da Row Level Security (supabase/migrations/0002_rls.sql), no
# mantener este valor en secreto.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
